<resources>
    <style name="HtcFlipDigits">
        <item name="android:fontFamily">sans-serif-thin</item>
        <item name="android:textColor">#303030</item>
        <item name="android:textSize">76sp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="HtcWeeklyFlipDigits" parent="HtcFlipDigits">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">#252525</item>
    </style>
    <style name="HtcSmallFlipDigits" parent="HtcFlipDigits">
        <item name="android:textSize">56sp</item>
    </style>
    <style name="HtcWeatherPrimary">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">#FFF7F7F7</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="HtcWeatherSecondary">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">#FFB8B8B8</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="HtcForecastDay">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="HtcForecastTemperature">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">#FFD0D0D0</item>
        <item name="android:textSize">11sp</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="HtcCompactForecastDay" parent="HtcForecastDay">
        <item name="android:textSize">9sp</item>
    </style>
    <style name="HtcCompactForecastTemperature" parent="HtcForecastTemperature">
        <item name="android:textSize">9sp</item>
    </style>
    <style name="HtcForecastColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="HtcForecastIcon">
        <item name="android:layout_width">58dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scaleType">fitCenter</item>
    </style>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#A8C93E</item><item name="android:navigationBarColor">#0B1013</item><item name="android:statusBarColor">#0B1013</item><item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
