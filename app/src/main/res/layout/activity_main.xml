<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_title"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="16dp"
            android:text="@string/intro"
            android:textColor="#FFC6D1D5"
            android:textSize="14sp" />

        <HorizontalScrollView
            android:id="@+id/preview_pager"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:fillViewport="true"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/preview_pages"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/classic_preview_page"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:foregroundGravity="center">

                    <include
                        android:id="@+id/classic_preview"
                        layout="@layout/widget_classic"
                        android:layout_width="match_parent"
                        android:layout_height="190dp"
                        android:layout_gravity="center" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/weekly_preview_page"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <include
                        android:id="@+id/weekly_preview"
                        layout="@layout/widget_weekly"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_gravity="center" />
                </FrameLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/preview_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="6dp"
            android:paddingBottom="8dp"
            android:text="@string/preview_classic_indicator"
            android:textColor="#FFC6D1D5"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/weather_section" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/weather_section_description" android:textColor="#FF9EADB3" android:textSize="13sp" />
            <EditText android:id="@+id/city_input" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:backgroundTint="@color/htc_green" android:hint="@string/city_hint" android:inputType="textPostalAddress" android:singleLine="true" android:textColor="#FFFFFFFF" android:textColorHint="#FF9EADB3" />
            <Button android:id="@+id/test_address_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:text="@string/test_address" />
            <Button android:id="@+id/location_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="@string/use_my_location" />
            <Button android:id="@+id/refresh_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:backgroundTint="@color/htc_green" android:text="@string/refresh" android:textColor="#FF101718" />
            <Button android:id="@+id/weather_details_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="@string/weather_details" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/clock_section" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/clock_section_description" android:textColor="#FF9EADB3" android:textSize="13sp" />
            <Button android:id="@+id/alarms_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/open_alarms" />
            <Button android:id="@+id/add_alarm_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="@string/add_alarm" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widgets_section" android:textColor="#FFFFFFFF" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="@string/widgets_section_description" android:textColor="#FF9EADB3" android:textSize="13sp" />
            <Button android:id="@+id/add_widget_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:text="@string/add_widget" />
            <Button android:id="@+id/add_weekly_widget_button" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="6dp" android:text="@string/add_weekly_widget" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/dashboard_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/information_section" android:textColor="#FFFFFFFF" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/last_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/no_weather_update" android:textColor="#FFC6D1D5" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/weather_source" android:textColor="#FF9EADB3" android:textSize="13sp" />
            <TextView android:id="@+id/app_version" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="#FF9EADB3" android:textSize="13sp" />
        </LinearLayout>

        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:padding="14dp" android:textColor="#FFD5DFE2" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
